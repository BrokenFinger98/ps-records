# Credentials — public repository, never commit
.ps/session
.ps/cookies*

# Cache (regenerable, large)
.ps/catalog.json

# The tracker's exclusive lock on this repository. It normally lives inside .git/, where git
# cannot see it; this covers the one case where it cannot — a run from before `git init`.
.programmers-tracker.lock

# OS
.DS_Store

# The tracker's working state, added by the server itself. It lives here so that it sits
# beside the records it describes, and it is not records: frames still being captured,
# per-problem timers, when the last push succeeded. `.ps/raw/recorded/` keeps one file
# per code run, and a run gets pressed dozens of times while solving one problem —
# committing them would bury your solving history in its own scratch work.
.ps/

# Obsidian's own state, added by the server because it is the thing doing the
# committing. Which panes you had open and how the graph is zoomed are not records, and
# `git add --all` cannot tell the difference — one backup commit here contained nothing
# but a changed graph setting, under a message about records. Delete this line if you
# would rather version your vault's settings; nothing else depends on it.
.obsidian/
