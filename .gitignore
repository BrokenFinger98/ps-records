# Credentials — public repository, never commit
.ps/session
.ps/cookies*

# Cache (regenerable, large)
.ps/catalog.json

# The tracker's exclusive lock on this repository. It normally lives inside .git/, where git
# cannot see it; this covers the one case where it cannot — a run from before `git init`.
.programmers-tracker.lock

# OS
.DS_Store

# The tracker's working state, added by the server itself: it lives here so that it
# sits beside the records it describes, and `.ps/raw/recorded/` is a copy of every
# attempts/00N.raw.jsonl. Committing it would push the whole capture history twice.
.ps/
